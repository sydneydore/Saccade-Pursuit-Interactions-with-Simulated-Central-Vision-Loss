%% Display Scotoma

% check for presence of a new sample update
if Eyelink('newfloatsampleavailable') > 0
    % get the sample in the form of an event structure
    evt = Eyelink('newestfloatsample');
    if eye_used ~= -1 % do we know which eye to use yet?
        % if we do, get current gaze position from sample

        % Detect a blink by computing velocity not to let scotoma go away
        if exist('t', 'var')
%                         vx = (1/40)*(evt.gx(eye_used+1)-x)/((evt.time-t)/1000);
            vel = (1/40)*(evt.gy(eye_used+1)-y)/((evt.time-t)/1000); % just using velocity on y axis to detect blink
%                         vel = sqrt(vx^2+vy^2);
        else
            vel = 0;
        end
        if vel > 900 && isBlinking == false
            tic
            isBlinking = true;
        end
        if isBlinking == true && toc >= 0.245
            isBlinking = false;
        end

        x = evt.gx(eye_used+1); % +1 as we're accessing MATLAB array
        y = evt.gy(eye_used+1);
        t = evt.time;

        % do we have valid data and is the pupil visible?
        if x~=el.MISSING_DATA && y~=el.MISSING_DATA && evt.pa(eye_used+1)>0
            % if data is valid, draw a circle on the screen at current gaze position using PsychToolbox's SCREEN function
			X = [y*x, y^2, x^2, y, x, 1];
            Y = X*Beta;
            x = Y(2); y = Y(1);
            if ~exist('x_prev', 'var') || (sqrt((x-x_prev)^2+(y-y_prev)^2) >= 2 && isBlinking == false) % Correction only if position shift big enough to smooth scotoma movements
                gazeRect=[x-scotomaDiameter/2 y-scotomaDiameter/2 x+scotomaDiameter/2 y+scotomaDiameter/2]; % Corrected (after scotoma calibration)
            end

            if exist('backgroundTexture', 'var') && exist('backgroundTextureBlurred', 'var')
                if isBlinking == false
                    Screen('DrawTexture', winPtr, backgroundTexture); % Redraw background
                else
                    Screen('DrawTexture', winPtr, backgroundTextureBlurred); % Redraw background, blurred
                end
            end

            if (exist('scotomaTexture', 'var'))
                Screen('DrawTexture', winPtr, scotomaTexture, [], gazeRect);
            else
                Screen('FillOval', winPtr, scotomaColor, gazeRect);
            end

            Screen('Flip', winPtr);
            x_prev = x; y_prev = y;
        end
    end
end
